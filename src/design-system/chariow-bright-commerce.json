{
  "version": "1.0",
  "name": "MindHubs Dark Premium Cyan",
  "description": "Dark premium commerce system for MindHubs, built around charcoal surfaces, cold white typography and cyan actions.",
  "colors": {
    "background": "#0F1113",
    "surface": "#1C1E20",
    "surfaceSecondary": "#23262A",
    "textPrimary": "#F7F7F8",
    "textSecondary": "#A8A8A8",
    "textSubtle": "#898A8B",
    "border": "#2E3031",
    "primary": "#6EE7FF",
    "primaryStrong": "#18DCFF",
    "secondaryAccent": "#FF005B",
    "success": "#9BE27A",
    "warning": "#E8B25C",
    "error": "#E58C72",
    "errorStrong": "#C45840",
    "info": "#7EA9FF"
  },
  "typography": {
    "display": { "fontFamily": "Inter", "fontSize": "48px", "fontWeight": 700, "lineHeight": 1.1, "letterSpacing": "-0.02em" },
    "heading": { "fontFamily": "Inter", "fontSize": "32px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em" },
    "body": { "fontFamily": "Inter", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
    "label": { "fontFamily": "Inter", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0" }
  },
  "rounded": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "full": "9999px" },
  "spacing": { "xs": "4px", "sm": "8px", "md": "12px", "base": "16px", "lg": "24px", "xl": "32px", "2xl": "48px", "3xl": "80px" },
  "components": {
    "buttonPrimary": { "backgroundColor": "{colors.primary}", "textColor": "{colors.background}", "rounded": "{rounded.md}", "padding": "10px 16px", "height": "44px" },
    "buttonSecondary": { "backgroundColor": "{colors.surfaceSecondary}", "textColor": "{colors.textPrimary}", "rounded": "{rounded.md}", "padding": "10px 16px", "height": "44px" },
    "card": { "backgroundColor": "{colors.surface}", "textColor": "{colors.textPrimary}", "borderColor": "{colors.border}", "rounded": "{rounded.md}", "padding": "16px" },
    "input": { "backgroundColor": "{colors.surface}", "textColor": "{colors.textPrimary}", "borderColor": "{colors.border}", "rounded": "{rounded.md}", "padding": "10px 12px", "height": "44px" }
  },
  "rules": {
    "primaryAccent": "Cyan is reserved for primary actions, active navigation, focus and brand identity.",
    "secondaryAccent": "Magenta is reserved for secondary emphasis and promotional moments.",
    "statusColors": "Success, warning, error and info are semantic states and must not be used as brand accents.",
    "vendorBranding": "Vendor colors are scoped to their storefront and never override the MindHubs application shell."
  }
}
